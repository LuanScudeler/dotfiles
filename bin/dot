#!/usr/bin/env bash

BIN_NAME=$(basename "$0")
COMMAND_NAME=$1
SUB_COMMAND_NAME=$2

sub_help () {
  echo "Usage: $BIN_NAME <command>"
  echo
  echo "Commands:"
  echo "   clean            Clean up caches (brew, gem)"
  echo "   edit             Open dotfiles in IDE ($VISUAL)"
  echo "   help             This help message"
  echo "   test             Run tests"
  echo "   update           Update packages and pkg managers (brew, pip3, npm, gems)"
}

sub_clean () {
  echo "$ brew cleanup"
  brew cleanup
  echo "$ gem cleanup"
  gem cleanup
}

sub_edit () {
  sh -c "$VISUAL $DOTFILES_DIR"
}

sub_test () {
  bats "$DOTFILES_DIR"/test/*.bats
}

sub_update () {
  topgrade
}

case $COMMAND_NAME in
  "" | "-h" | "--help")
    sub_help
    ;;
  *)
    shift
    sub_${COMMAND_NAME} $@
    if [ $? = 127 ]; then
      echo "'$COMMAND_NAME' is not a known command or has errors." >&2
      sub_help
      exit 1
    fi
    ;;
esac
