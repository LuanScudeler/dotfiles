export EDITOR="code"
export VISUAL="code"
export VISUAL_GIT="code"

# Java (OpenJDK 25 LTS via Homebrew)
[ -d "$HOMEBREW_PREFIX/opt/openjdk@25/libexec" ] && export JAVA_HOME="$HOMEBREW_PREFIX/opt/openjdk@25/libexec"

# .NET SDK (via Homebrew)
[ -d "$HOMEBREW_PREFIX/opt/dotnet/libexec" ] && export DOTNET_ROOT="$HOMEBREW_PREFIX/opt/dotnet/libexec"
